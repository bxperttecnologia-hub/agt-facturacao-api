# Copia este ficheiro para ".env" e preenche os valores antes de arrancar a API.

NODE_ENV=development
PORT=3000
# Origens permitidas para CORS, separadas por vírgula (deixa vazio para bloquear tudo)
CORS_ORIGIN=

# Base de dados MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=agt_facturacao
DB_CONNECTION_LIMIT=10

# Chave que os teus próprios sistemas devem enviar no cabeçalho "x-api-key".
# NUNCA uses o valor de exemplo abaixo em produção — gera uma nova com:
#   openssl rand -base64 32
API_KEY=muda-me-gera-uma-chave-forte-unica

# Limite de pedidos gerais por IP
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Valor por omissão do documentStatus usado em POST /api/faturas/corrigir
# quando o pedido não traz o seu próprio document_status. Ver aviso em
# src/agt/corrigirFaturaAgt.js — 'R' não está confirmado contra a carta de
# códigos oficial da AGT.
CORRECTION_DOCUMENT_STATUS=R

# Ambiente de testes (homologação) da AGT — preenche com as TUAS credenciais
# de homologação, nunca comites valores reais neste ficheiro.
AGT_TEST_BASE_URL=https://sifphml.minfin.gov.ao
AGT_TEST_SOFTWARE_PRODUCT_ID=
AGT_TEST_SOFTWARE_VERSION=
AGT_TEST_SOFTWARE_VALIDATION=
AGT_TEST_SOFTWARE_JWS_SIGNATURE=
AGT_TEST_USERNAME=
AGT_TEST_PASSWORD=

# Ambiente de produção da AGT
AGT_PROD_BASE_URL=https://sifp.minfin.gov.ao
AGT_PROD_SOFTWARE_PRODUCT_ID=
AGT_PROD_SOFTWARE_VERSION=
AGT_PROD_SOFTWARE_VALIDATION=
AGT_PROD_SOFTWARE_JWS_SIGNATURE=
AGT_PROD_USERNAME=
AGT_PROD_PASSWORD=
