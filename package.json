{
  "name": "agt-facturacao-api",
  "version": "1.0.0",
  "description": "API proxy para a Facturação Electrónica da AGT (Angola): assina e reencaminha pedidos de série/factura/consulta de estado, guardando apenas log em MySQL.",
  "main": "src/server.js",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "mysql2": "^3.11.0",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^30.5.1",
    "pino-pretty": "^11.2.2",
    "supertest": "^7.2.2"
  }
}
